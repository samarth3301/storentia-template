# The storefront reads everything through @storentia/sdk. There is no offline
# fallback: without these values the app raises a configuration error.

# OAuth credentials from the Storentia dashboard (required).
STORENTIA_CLIENT_ID=
STORENTIA_CLIENT_SECRET=
# Override for local or staging APIs; defaults to https://apis.storentia.com
STORENTIA_API_BASE_URL=
# Public store token — required for customer email-code sign-in.
STORENTIA_STORE_TOKEN=
# Store UUID — required for discount-code validation.
STORENTIA_STORE_ID=

NEXT_PUBLIC_STORE_NAME=Storentia
NEXT_PUBLIC_CDN_BASE=https://cdn.storentia.com
NEXT_PUBLIC_CURRENCY=INR
